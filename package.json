{
  "name": "rakkr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "build": "mise run build",
    "build:rust": "mise run rust:build",
    "build:ts": "mise run node:build",
    "check": "mise run check",
    "check:loc": "node scripts/check-loc.mjs",
    "check:rust": "mise run rust:check",
    "check:ts": "mise run node:check",
    "db:generate": "mise run db:generate",
    "dev": "mise run dev",
    "format": "mise run node:format && mise run rust:fmt",
    "format:check": "mise run node:format-check && mise run rust:fmt-check",
    "lint": "mise run node:lint"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tailwindcss": "^1.6.0",
    "prettier": "^3.9.6",
    "yaml": "^2.9.0"
  }
}
